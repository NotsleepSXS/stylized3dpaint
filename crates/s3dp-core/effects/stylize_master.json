    {"id": "gr_blend2", "label": "Bottom Blend", "label_ru": "Наложение снизу", "type": "enum", "options": [["normal", "Normal", "Обычное"], ["multiply", "Multiply", "Умножение"], ["screen", "Screen", "Экран"], ["overlay", "Overlay", "Перекрытие"], ["soft_light", "Soft Light", "Мягкий свет"]], "default": 1, "group": "Gradient", "group_ru": "Градиент"},
