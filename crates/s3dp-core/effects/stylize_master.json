    {"id": "co_scale", "label": "Pattern Scale", "label_ru": "Масштаб узора", "type": "float", "min": 0.01, "max": 1, "default": 0.15, "logarithmic": true, "group": "Colorize", "group_ru": "Тонирование"},

    {"id": "gr_strength", "label": "Strength", "label_ru": "Сила", "type": "float", "min": 0, "max": 1, "default": 0.6, "group": "Gradient", "group_ru": "Градиент", "tip": "0 = off", "tip_ru": "0 = выкл."},
