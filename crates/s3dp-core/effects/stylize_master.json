{
  "id": "stylize_master",
  "name": "Stylization",
  "name_ru": "Стилизация",
  "category": "stylize",
  "description": "Main hand-painted stylization filter: painterly brush strokes, smoothing of photo detail, colorize, gradient, baked lighting and edge / cavity accents. Place it as an effect layer or on a folder. A group with strength 0 is off.",
  "description_ru": "Главный фильтр рисованной стилизации: мазки кисти, сглаживание фотодеталей, тонирование, градиент, запечённое освещение и акценты граней / полостей. Ставится как слой эффекта или на папку. Группа с силой 0 выключена.",
  "neighbors": true,
  "maps": ["ambient_occlusion", "edges", "cavity", "curvature", "sky_light"],
  "params": [
    {"id": "strength", "label": "Stylization", "label_ru": "Сила стилизации", "type": "float", "min": 0, "max": 1, "default": 1, "group": "Global", "group_ru": "Общие", "tip": "Scales every group below", "tip_ru": "Масштабирует все группы ниже"},

    {"id": "br_strength", "label": "Strength", "label_ru": "Сила", "type": "float", "min": 0, "max": 1, "default": 0.8, "group": "Brush Strokes", "group_ru": "Мазки кисти", "tip": "0 = strokes off", "tip_ru": "0 = мазки выключены"},
    {"id": "br_amount", "label": "Amount", "label_ru": "Количество", "type": "float", "min": 0, "max": 1, "default": 0.9, "group": "Brush Strokes", "group_ru": "Мазки кисти", "tip": "Density of strokes", "tip_ru": "Плотность мазков"},
    {"id": "br_scale", "label": "Scale", "label_ru": "Масштаб", "type": "float", "min": 0.005, "max": 0.3, "default": 0.05, "logarithmic": true, "group": "Brush Strokes", "group_ru": "Мазки кисти", "tip": "Stroke spacing relative to the object", "tip_ru": "Шаг мазков относительно объекта"},
    {"id": "br_size_x", "label": "Size X", "label_ru": "Размер X", "type": "float", "min": 0.1, "max": 1.6, "default": 1.4, "group": "Brush Strokes", "group_ru": "Мазки кисти", "tip": "Stroke length", "tip_ru": "Длина мазка"},
    {"id": "br_size_y", "label": "Size Y", "label_ru": "Размер Y", "type": "float", "min": 0.05, "max": 1.6, "default": 0.55, "group": "Brush Strokes", "group_ru": "Мазки кисти", "tip": "Stroke width", "tip_ru": "Ширина мазка"},
    {"id": "br_scale_rand", "label": "Scale Random", "label_ru": "Случайный размер", "type": "float", "min": 0, "max": 1, "default": 0.4, "group": "Brush Strokes", "group_ru": "Мазки кисти"},
    {"id": "br_rotation", "label": "Rotation", "label_ru": "Поворот", "type": "float", "min": -180, "max": 180, "default": 0, "group": "Brush Strokes", "group_ru": "Мазки кисти", "tip": "Degrees from the world up direction", "tip_ru": "Градусы от мирового направления вверх"},
    {"id": "br_rot_rand", "label": "Rotation Random", "label_ru": "Случайный поворот", "type": "float", "min": 0, "max": 1, "default": 0.25, "group": "Brush Strokes", "group_ru": "Мазки кисти"},
    {"id": "br_normal_thr", "label": "Normal Threshold", "label_ru": "Порог нормали", "type": "float", "min": 5, "max": 90, "default": 40, "group": "Brush Strokes", "group_ru": "Мазки кисти", "tip": "Strokes stop where the surface turns more than this angle (degrees)", "tip_ru": "Мазки обрываются, где поверхность поворачивает больше этого угла (градусы)"},
    {"id": "br_color_var", "label": "Color Variation", "label_ru": "Вариация цвета", "type": "float", "min": 0, "max": 1, "default": 0.35, "group": "Brush Strokes", "group_ru": "Мазки кисти", "tip": "Per-stroke value / hue jitter and bristle streaks", "tip_ru": "Разброс яркости / тона по мазкам и следы щетины"},
    {"id": "seed", "label": "Seed", "label_ru": "Сид", "type": "seed", "default": 1, "group": "Brush Strokes", "group_ru": "Мазки кисти"},

